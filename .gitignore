```gitignore
# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
dist/
build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/

# Temporary files
tmp/
temp/

# Optional local configuration
*.local
```
